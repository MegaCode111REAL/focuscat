	"name": "focuscat",
	"private": true,
	"description": "",
	"keywords": [],
	"homepage": "https://focuscat.app/?utm_source=github",
	"bugs": {
		"url": "https://github.com/builder-group/focuscat/issues"
	},
	"repository": {
		"type": "git",
