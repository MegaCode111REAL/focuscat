	},
	"license": "AGPL-3.0-or-later",
	"author": "@bennobuilder",
	"scripts": {
		"build": "turbo run build",
		"clean": "turbo run clean --force && shx rm -rf .turbo && shx rm -rf .vercel && shx rm -rf node_modules",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,md,mdx,json,css,html}\"",
		"install:clean": "pnpm clean && pnpm install && pnpm build",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint --force -- --fix",
		"start:dev": "turbo run start:dev",
		"test": "turbo run test",
		"update:latest": "turbo run update:latest --force --concurrency=1 && pnpm update --latest '!typescript' && pnpm build"
	},
	"devDependencies": {
		"@blgc/config": "^0.1.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"prettier": "^3.9.10",
		"rollup": "^4.64.5",
		"rollup-presets": "^0.0.30",
		"shx": "^0.4.0",
		"turbo": "^2.11.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=24"
	}
}
